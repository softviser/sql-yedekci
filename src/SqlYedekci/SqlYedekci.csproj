<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SqlYedekci</AssemblyName>
    <RootNamespace>SqlYedekci</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <SatelliteResourceLanguages>tr</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>

    <Version>3.0.1</Version>
    <Product>SQL Yedekçi</Product>
    <AssemblyTitle>SQL Yedekçi</AssemblyTitle>
    <Description>SQL Server veritabanlarını zamanlanmış olarak yedekler, sıkıştırır, eski yedekleri temizler ve geri yükler.</Description>
    <Company>Softviser Yazılım</Company>
    <Authors>Softviser Yazılım</Authors>
    <Copyright>© 2026 Softviser Yazılım — softviser.com.tr</Copyright>
    <PackageProjectUrl>https://softviser.com.tr</PackageProjectUrl>
    <RepositoryUrl>https://github.com/softviser/sql-yedekci</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <NeutralLanguage>tr-TR</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SqlYedekci.Tests" />
  </ItemGroup>

</Project>
